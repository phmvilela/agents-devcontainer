{
    "name": "pgcyan Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--cap-add=NET_ADMIN",
        "--cap-add=NET_RAW"
    ],
    "mounts": [
        "source=${localEnv:HOME}/allowed_domains,target=/etc/allowed_domains,type=bind,readonly",
        // Claude Code's config home on a named Docker volume, so sessions,
        // transcripts, credentials, settings, plugins and skills survive a
        // container rebuild. Named volumes outlive both `docker rm` and
        // "Rebuild Container"; they are only removed explicitly, with
        // `docker volume rm pgcyan-claude-home`.
        //
        // Deliberately a volume and not a bind mount of the host's ~/.claude:
        // container sessions stay separate from host ones, and there is no
        // UID/permission mismatch to work around on WSL2.
        "source=pgcyan-claude-home,target=/home/vscode/.claude,type=volume"
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "git.repositoryScanMaxDepth": 2,
                "task.allowAutomaticTasks": "on"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "anthropic.claude-code"
            ]
        }
    },
    "forwardPorts": [
        5173
    ],
    "containerEnv": {
        "DISABLE_AUTOUPDATER": "1",
        // Sign commits with a container-local GPG keyring instead of the host
        // gpg-agent socket VS Code forwards to ~/.gnupg (that forwarded agent
        // forbids loopback pinentry, breaking headless signing). See
        // .devcontainer/post-start.d/20-gpg-signing.sh for the full rationale.
        "GNUPGHOME": "/home/vscode/.gnupg-signing",
        // Claude Code's config home. This is already its default location, but
        // setting it explicitly also moves the global config file from
        // ~/.claude.json to ~/.claude/.claude.json -- i.e. onto the persistent
        // volume above. That file holds onboarding state, per-project trust
        // and history, and MCP server definitions, so without this it would be
        // the one piece of Claude Code state still lost on every rebuild.
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "bash .devcontainer/post-start.sh",
    // Inject your API Key / tokens from your Windows/WSL environment
    "remoteEnv": {
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
        "GH_TOKEN": "${localEnv:GH_TOKEN}",
        // Base64-encoded ASCII-armored private key + optional passphrase (see post-create.sh)
        "GPG_PRIVATE_KEY": "${localEnv:GPG_PRIVATE_KEY}",
        "GPG_PASSPHRASE": "${localEnv:GPG_PASSPHRASE}",
        // Base64-encoded standalone, read-only kubeconfig generated on the HOST
        "KUBECONFIG_B64": "${localEnv:KUBECONFIG_B64}",
        // Windows host's real LAN IP -- WORKAROUND for a WSL2 bug where
        // Windows<->WSL2 IPv4 loopback forwarding hangs (breaks
        // host.docker.internal). Only needed if that's broken for you; see
        // .devcontainer/host-setup/README.md. Set in your WSL shell profile.
        "HOST_LAN_IP": "${localEnv:HOST_LAN_IP}"
    },
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "waitFor": "postStartCommand"
}